{
  "MonitoringConfig": {
    "PollingIntervalSeconds": 60,
    "TimeoutSeconds": 30,

    "SapSystems": [
      {
        "Name": "SAP-PRD",
        "Enabled": true,
        "Host": "sap-prd.company.com",
        "SystemNumber": 0,
        "Client": "100",
        "SystemId": "PRD",
        "User": "MONITOR_USER",
        "Password": "SECRET",
        "Language": "EN",
        "ResponseTimeWarningMs": 3000,
        "ResponseTimeCriticalMs": 8000,
        "MonitorTransports": true,
        "TransportQueueWarningThreshold": 10,
        "MonitorShortDumps": true,
        "ShortDumpWindowMinutes": 60,
        "ShortDumpWarningThreshold": 5,
        "MonitorWorkProcesses": true,
        "MinFreeWorkProcessPercent": 20,
        "MonitorBatchJobs": true,
        "BatchJobWindowMinutes": 60,
        "BatchJobCancelledWarningThreshold": 1,
        "MonitorIdocs": true,
        "IdocWindowMinutes": 60,
        "IdocErrorRateWarningPct": 5.0,
        "IdocErrorRateCriticalPct": 20.0,
        "MonitorSyslog": true,
        "SyslogWindowMinutes": 30,
        "SyslogErrorWarningThreshold": 10
      },
      {
        "Name": "SAP-QAS",
        "Enabled": true,
        "Host": "sap-qas.company.com",
        "SystemNumber": 0,
        "Client": "100",
        "SystemId": "QAS",
        "User": "MONITOR_USER",
        "Password": "SECRET",
        "Language": "EN",
        "ResponseTimeWarningMs": 5000,
        "ResponseTimeCriticalMs": 12000,
        "MonitorTransports": true,
        "TransportQueueWarningThreshold": 20,
        "MonitorShortDumps": true,
        "ShortDumpWindowMinutes": 60,
        "ShortDumpWarningThreshold": 10,
        "MonitorWorkProcesses": true,
        "MinFreeWorkProcessPercent": 15,
        "MonitorBatchJobs": true,
        "BatchJobWindowMinutes": 60,
        "BatchJobCancelledWarningThreshold": 3,
        "MonitorIdocs": true,
        "IdocWindowMinutes": 60,
        "IdocErrorRateWarningPct": 10.0,
        "IdocErrorRateCriticalPct": 30.0,
        "MonitorSyslog": true,
        "SyslogWindowMinutes": 30,
        "SyslogErrorWarningThreshold": 20
      }
    ],

    "DynamicsAxSystems": [
      {
        "Name": "D365-PROD",
        "Enabled": true,
        "BaseUrl": "https://company.operations.dynamics.com",
        "TenantId": "your-tenant-id",
        "ClientId": "your-client-id",
        "ClientSecret": "your-client-secret",
        "Resource": "https://company.operations.dynamics.com",
        "ResponseTimeWarningMs": 5000,
        "ResponseTimeCriticalMs": 15000,
        "ProbeEntities": [ "SystemParameters", "LegalEntities" ]
      }
    ],

    "Databases": [
      {
        "Name": "SQL-AX-PROD",
        "Enabled": true,
        "Type": "SqlServer",
        "ConnectionString": "Server=sql-prod.company.com;Database=DynamicsAX;User Id=monitor;Password=SECRET;TrustServerCertificate=True;",
        "ResponseTimeWarningMs": 1000,
        "ResponseTimeCriticalMs": 5000,
        "ProbeQuery": "SELECT 1"
      },
      {
        "Name": "SQL-SAP-SIDADM",
        "Enabled": false,
        "Type": "SqlServer",
        "ConnectionString": "Server=sap-db.company.com;Database=PRD;User Id=monitor;Password=SECRET;TrustServerCertificate=True;",
        "ResponseTimeWarningMs": 2000,
        "ResponseTimeCriticalMs": 8000,
        "ProbeQuery": "SELECT 1"
      }
    ],

    "WebApis": [
      {
        "Name": "D365-HealthEndpoint",
        "Enabled": true,
        "Url": "https://company.operations.dynamics.com/api/healthz",
        "Method": "GET",
        "Headers": {},
        "ResponseTimeWarningMs": 3000,
        "ResponseTimeCriticalMs": 10000,
        "ExpectedStatusCodes": [ 200 ],
        "ExpectedBodyContains": null
      },
      {
        "Name": "SAP-Fiori-Launchpad",
        "Enabled": true,
        "Url": "https://fiori.company.com/sap/bc/ui5_ui5/ui2/ushell/shells/abap/FioriLaunchpad.html",
        "Method": "GET",
        "Headers": {},
        "ResponseTimeWarningMs": 4000,
        "ResponseTimeCriticalMs": 12000,
        "ExpectedStatusCodes": [ 200 ],
        "ExpectedBodyContains": null
      },
      {
        "Name": "Internal-API-Gateway",
        "Enabled": true,
        "Url": "https://api-gw.company.com/health",
        "Method": "GET",
        "Headers": {
          "X-Api-Key": "your-api-key"
        },
        "ResponseTimeWarningMs": 2000,
        "ResponseTimeCriticalMs": 6000,
        "ExpectedStatusCodes": [ 200 ],
        "ExpectedBodyContains": "ok"
      }
    ],

    "WindowsServices": [
      {
        "Name": "AX-Batch-Service",
        "Enabled": true,
        "ServiceName": "DynamicsAxBatch",
        "MachineName": null
      },
      {
        "Name": "SAP-Message-Server",
        "Enabled": false,
        "ServiceName": "SAPMS$PRD",
        "MachineName": "sap-app-01"
      }
    ],

    "FileSystems": [
      {
        "Name": "AX-FileShare",
        "Enabled": true,
        "Path": "C:\\AXShares\\Integration",
        "FreeSpaceWarningMB": 2048,
        "FreeSpaceCriticalMB": 512,
        "StaleFileWindowMinutes": null
      },
      {
        "Name": "SAP-Transport-Dir",
        "Enabled": false,
        "Path": "/usr/sap/trans",
        "FreeSpaceWarningMB": 5120,
        "FreeSpaceCriticalMB": 1024,
        "StaleFileWindowMinutes": null
      }
    ],

    "Alerts": {
      "EnableConsoleAlerts": true,
      "EnableFileLog": true,
      "LogFilePath": "logs/monitoring-alerts.log",
      "Email": {
        "Enabled": false,
        "SmtpHost": "smtp.company.com",
        "SmtpPort": 587,
        "UseSsl": true,
        "FromAddress": "monitoring@company.com",
        "FromName": "IT Monitoring",
        "Username": "monitoring@company.com",
        "Password": "SECRET",
        "ToAddresses": [ "it-team@company.com", "sap-basis@company.com" ],
        "MinimumSeverity": "Warning"
      },
      "Webhook": {
        "Enabled": false,
        "Url": "https://outlook.office.com/webhook/YOUR-TEAMS-WEBHOOK-URL",
        "Headers": {},
        "MinimumSeverity": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "MonitoringTool": "Debug"
    }
  }
}
